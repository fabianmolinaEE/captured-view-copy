# Server only. Copy to .env for local development (Node >=22.12); never commit .env.
# In Lovable hosting, configure these in Secrets/runtime bindings and restart/redeploy.
GEMINI_API_KEY=

# Verified in current Google model documentation, 2026-11-11. Override for your account.
GEMINI_MODEL=gemini-3.5-flash-lite
# Long random workspace access code. Required for every non-local research API.
# Team members enter ONLY this workspace code in Settings; never enter API keys there.
RESEARCH_ACCESS_TOKEN=

# Optional shared storage. Provision table + PRIVATE bucket through Lovable first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEARCH_VIDEO_BUCKET=research-recordings
